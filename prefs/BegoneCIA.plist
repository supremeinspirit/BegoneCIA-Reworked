<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
	<key>entry</key><dict>
		<key>cell</key><string>PSLinkCell</string>
		<key>label</key><string>BegoneCIA</string>
		<key>icon</key><string>BegoneCIA.png</string>
	</dict>
	<key>title</key><string>BegoneCIA</string>
	<key>items</key><array>
		<dict>
			<key>cell</key><string>PSGroupCell</string>
			<key>footerText</key><string>Blocks microphone, camera and location system-wide. Same as the toggle in Control Center.</string>
		</dict>
		<dict>
			<key>cell</key><string>PSSwitchCell</string>
			<key>label</key><string>BegoneCIA Enabled</string>
			<key>defaults</key><string>me.nepeta.begonecia</string>
			<key>key</key><string>Enabled</string>
			<key>default</key><false/>
			<key>PostNotification</key><string>me.nepeta.begonecia/ReloadPrefs</string>
		</dict>
		<dict>
			<key>cell</key><string>PSGroupCell</string>
			<key>label</key><string>Calls</string>
			<key>footerText</key><string>On: BegoneCIA pauses while a call is ringing or in progress and blocks again afterwards. Off: BegoneCIA stays active during calls. “Calls” means Phone and calling apps such as WhatsApp; “FaceTime” means FaceTime audio and video.</string>
		</dict>
		<dict>
			<key>cell</key><string>PSSwitchCell</string>
			<key>label</key><string>Pause During Calls</string>
			<key>defaults</key><string>me.nepeta.begonecia</string>
			<key>key</key><string>PauseOnCalls</string>
			<key>default</key><false/>
			<key>PostNotification</key><string>me.nepeta.begonecia/ReloadPrefs</string>
		</dict>
		<dict>
			<key>cell</key><string>PSSwitchCell</string>
			<key>label</key><string>Pause During FaceTime</string>
			<key>defaults</key><string>me.nepeta.begonecia</string>
			<key>key</key><string>PauseOnFaceTime</string>
			<key>default</key><false/>
			<key>PostNotification</key><string>me.nepeta.begonecia/ReloadPrefs</string>
		</dict>
		<dict>
			<key>cell</key><string>PSGroupCell</string>
			<key>label</key><string>Exceptions</string>
			<key>footerText</key><string>Excluded apps can always use the camera and location. The microphone is unblocked while an excluded app is in the foreground.</string>
		</dict>
		<dict>
			<key>cell</key><string>PSLinkListCell</string>
			<key>bundle</key><string>AltList</string>
			<key>isController</key><true/>
			<key>detail</key><string>ATLApplicationListMultiSelectionController</string>
			<key>label</key><string>Excluded Apps</string>
			<key>defaults</key><string>me.nepeta.begonecia</string>
			<key>key</key><string>ExcludedApps</string>
			<key>defaultApplicationSwitchValue</key><false/>
			<key>PostNotification</key><string>me.nepeta.begonecia/ReloadPrefs</string>
			<key>sections</key><array>
				<dict><key>sectionType</key><string>Visible</string></dict>
			</array>
			<key>useSearchBar</key><true/>
			<key>alphabeticIndexingEnabled</key><true/>
		</dict>
	</array>
</dict></plist>
